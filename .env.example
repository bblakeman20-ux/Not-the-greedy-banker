# Platform-wide Gemini API Key for Gerg AI ideas, swipe decks, and date extraction.
# Set this environment variable in your hosting environment (Cloud Run / Vercel / .env.local).
GEMINI_API_KEY=

# Optional: comma-separated Gemini models to try in order (defaults to fast latest models)
# GEMINI_MODELS=gemini-flash-latest,gemini-3.8-flash,gemini-3.1-flash-lite

# Internal port (Cloud Run forwards from 8080 to 3000)
PORT=3000
