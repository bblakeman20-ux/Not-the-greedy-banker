{
  "rules": {
    ".read": false,
    ".write": false,
    "v2": {
      "rooms": {
        "$room": {
          ".read": "$room.length >= 12",
          ".write": "$room.length >= 12 && newData.exists() && newData.child('ver').isNumber()"
        }
      },
      "clock": {
        "$device": {
          ".read": "$device.length <= 20",
          ".write": "$device.length <= 20 && newData.isNumber() && newData.val() == now"
        }
      }
    }
  }
}
